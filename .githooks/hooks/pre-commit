#!/usr/bin/env sh
# Pre-commit entrypoint: tiny runner only. Execute every executable check in
# .githooks/pre-commit/ in sorted order, forward the hook args, and stop on the
# first non-zero exit. Each check is standalone (it works out its own staged
# file set), so add or drop a check by adding or removing a script there. Bypass
# in an emergency with `--no-verify`.
set -eu

dir="$(git rev-parse --show-toplevel)/.githooks/pre-commit"
for script in "$dir"/*.sh; do
  [ -x "$script" ] || continue
  "$script" "$@"
done
