#!/usr/bin/env sh
# Pre-push entrypoint: tiny runner only. Execute every executable check in
# .githooks/pre-push/ in sorted order, forward the hook args, and stop on the
# first non-zero exit. Each check is standalone (it works out its own file set
# over the whole tree), so add or drop a check by adding or removing a script
# there. Bypass in an emergency with `--no-verify`.
set -eu

dir="$(git rev-parse --show-toplevel)/.githooks/pre-push"
for script in "$dir"/*.sh; do
  [ -x "$script" ] || continue
  "$script" "$@"
done
