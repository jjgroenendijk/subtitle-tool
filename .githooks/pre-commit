#!/usr/bin/env bash
# Pre-commit hook: run every check script in scripts/pre-commit/, in name order.
# Each script is standalone (it works out its own staged file set), so this hook
# is just a runner: add or drop a check by adding or removing a script there. Any
# non-zero exit aborts the commit. Bypass in an emergency with `--no-verify`.
set -euo pipefail

dir="$(git rev-parse --show-toplevel)/scripts/pre-commit"
shopt -s nullglob
for script in "$dir"/*.sh; do
  [ -x "$script" ] || continue
  "$script"
done
