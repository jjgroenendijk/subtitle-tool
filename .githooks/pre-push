#!/usr/bin/env bash
# Pre-push hook: run every check script in scripts/pre-push/, in name order. Each
# script is standalone (it works out its own file set over the whole tree), so
# this hook is just a runner: add or drop a check by adding or removing a script
# there. Any non-zero exit aborts the push. Bypass in an emergency with
# `--no-verify`.
set -euo pipefail

dir="$(git rev-parse --show-toplevel)/scripts/pre-push"
shopt -s nullglob
for script in "$dir"/*.sh; do
  [ -x "$script" ] || continue
  "$script"
done
